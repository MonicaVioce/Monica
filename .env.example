# Copy to .env and fill in — never commit the real values.
A1_TEAM_KEY=team-xxxxxxxxxxxx      # a1mobile API credential (calls, SMS, MCP)
MONICA_NUMBER=+1xxxxxxxxxx         # Monica's outbound number (from the a1mobile dashboard)
SIP_USERNAME=xxxxxxxx              # SIP trunk creds, host sip.telnyx.com
SIP_PASSWORD=xxxxxxxx

# OpenAI Realtime SIP agent.
OPENAI_API_KEY=
OPENAI_PROJECT_ID=proj_your_project_id
OPENAI_WEBHOOK_SECRET=whsec_your_openai_webhook_secret
PUBLIC_BASE_URL=https://your-public-domain.example
PORT=3000

# Optional: add this token to the A1 voice webhook URL as ?token=<value>.
VOICE_WEBHOOK_TOKEN=
MONICA_ADMIN_TOKEN=replace-with-a-long-random-secret

# Structured facts and negotiation boundary for the active case. Do not put
# payment-card details, passwords, one-time codes, or identity documents here.
MONICA_CASE_CONTEXT={"customer_name":"","customer_phone":"","company":"","reservation_or_case_id":"","issue":"","requested_resolution":"","acceptance_limit":"","authorized_actions":[]}
